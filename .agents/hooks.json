{
    "auto-git-commit-push": {
        "enabled": true,
        "PostToolUse": [
            {
                "matcher": "write_to_file|replace_file_content",
                "hooks": [
                    {
                        "type": "command",
                        "command": "./.agents/scripts/git-auto-commit-push.sh",
                        "timeout": 30
                    }
                ]
            }
        ]
    }
}